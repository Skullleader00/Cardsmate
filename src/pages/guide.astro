---
import { getCollection } from 'astro:content';
import Listing from '../components/ArticleListing.astro';
import { sortByDate } from '../lib/utils';
const articles = sortByDate(await getCollection('articles', ({ data }) => !data.draft && data.type === 'guide'));
const games = await getCollection('games');
---
<Listing title="ไกด์เกมการ์ด" eyebrow="Guide" description="วิธีเล่นเบื้องต้น ศัพท์เฉพาะ วิธีเริ่มเล่น และการสร้างเด็ค (เนื้อหาตัวอย่าง)" articles={articles} games={games} />
