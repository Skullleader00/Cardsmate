---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---
<BaseLayout title="นโยบายความเป็นส่วนตัว" description="นโยบายความเป็นส่วนตัวของ Cardsmate" noindex>
  <PageHeader title="นโยบายความเป็นส่วนตัว" eyebrow="Privacy / Terms" desc="เอกสารตัวอย่าง — ปรับใช้กับโดเมนและธุรกิจจริงของคุณก่อนเผยแพร่" />
  <div class="mx-auto max-w-3xl px-4 py-10 prose-cardsmate">
    <p class="text-sm text-[var(--fg-muted)]">อัปเดตล่าสุด: (ตัวอย่าง) · เอกสารนี้เป็นแม่แบบภาษาอังกฤษ/ไทยอย่างย่อ ไม่ใช่คำแนะนำทางกฎหมาย</p>
    <h2>ข้อมูลที่เราเก็บ</h2>
    <p>Cardsmate เป็นเว็บไซต์แบบ static (หน้าเว็บถูกสร้างล่วงหน้า) เรา<b>ไม่มีฐานข้อมูลผู้ใช้</b>และไม่เก็บข้อมูลส่วนบุคคลบนเซิร์ฟเวอร์ ระบบค้นหาทำงานฝั่งเบราว์เซอร์ (client-side) ผ่าน Pagefind จึงไม่ต้องส่งคำค้นไปยังเซิร์ฟเวอร์</p>
    <h2>คุกกี้และที่จัดเก็บในเครื่อง</h2>
    <p>เราบันทึกเฉพาะค่าธีม (สว่าง/มืด) ใน <code>localStorage</code> ของเบราว์เซอร์คุณ เพื่อจำการตั้งค่าที่เลือกไว้</p>
    <h2>ลิงก์ภายนอกและแบบอักษร</h2>
    <p>หน้าเว็บโหลดฟอนต์จาก Google Fonts ซึ่งอาจบันทึก IP ของคุณตามนโยบายของผู้ให้บริการภายนอกนั้น</p>
    <h2>ช่องทางติดต่อ</h2>
    <p>หากมีข้อสงสัยเกี่ยวกับความเป็นส่วนตัว สามารถติดต่อผ่านหน้า <a href="/contact | url">ติดต่อเรา</a></p>
  </div>
</BaseLayout>
