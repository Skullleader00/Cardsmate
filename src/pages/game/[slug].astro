---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url, SITE } from '../../site';
import { PLATFORM_LABEL, sortByDate } from '../../lib/utils';
import ArticleCard from '../../components/ArticleCard.astro';
import DeckCard from '../../components/DeckCard.astro';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((g) => ({ params: { slug: g.id }, props: { game: g } }));
}

const { game } = Astro.props;
const d = game.data;
const { Content, headings } = await render(game);

const articles = sortByDate((await getCollection('articles', ({ data }) => !data.draft)).filter((a) => a.data.game === game.id));
const decks = (await getCollection('decks', ({ data }) => !data.draft)).filter((x) => x.data.game === game.id);
const terms = (await getCollection('glossary')).filter((t) => t.data.game === game.id);
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'VideoGame', name: d.name,
  publisher: { '@type': 'Organization', name: d.publisher }, genre: 'Card game', inLanguage: 'th',
};
---
<BaseLayout title={d.name} description={d.description} jsonLd={jsonLd} ogImage={d.hero ? url(d.hero) : undefined}>
  <header class="border-b border-[var(--border)]" style={`background:linear-gradient(150deg, color-mix(in srgb, ${d.accent} 25%, var(--bg)), var(--bg))`}>
    <div class="mx-auto flex max-w-[var(--maxw)] flex-wrap items-center gap-5 px-4 py-12">
      <span class="grid h-20 w-20 place-items-center rounded-2xl font-head text-4xl font-black text-[#0f1220]" style={`background:${d.accent}`}>{d.shortName.slice(0,1)}</span>
      <div class="min-w-0">
        <h1 class="font-head text-3xl font-black sm:text-4xl">{d.name}</h1>
        <p class="mt-1 text-[var(--fg-muted)]">{d.publisher}{d.startedYear ? ` · ตั้งแต่ ${d.startedYear} (ตัวอย่าง)` : ''}</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {d.platforms.map((p) => (<span class="rounded-full border border-[var(--border)] bg-[var(--bg-elev)] px-3 py-1 text-xs">{PLATFORM_LABEL[p]}</span>))}
        </div>
      </div>
    </div>
  </header>

  <div class="mx-auto grid max-w-[var(--maxw)] gap-8 px-4 py-10 lg:grid-cols-[minmax(0,1fr)_300px]">
    <div class="min-w-0">
      <div class="prose-cardsmate max-w-none"><Content /></div>

      {d.gettingStarted && (
        <div class="mt-8 rounded-2xl border border-[var(--border)] bg-[var(--bg-elev)] p-5">
          <h2 class="font-head text-lg font-bold text-[var(--gold)]">เริ่มเล่นอย่างไร</h2>
          <p class="mt-2 text-[var(--fg-muted)]">{d.gettingStarted}</p>
          <a href={url('/guide')} class="mt-3 inline-block rounded-lg bg-gradient-to-r from-[var(--accent)] to-[var(--gold)] px-4 py-2 text-sm font-semibold text-[#0f1220]">อ่านไกด์เริ่มต้นทั้งหมด</a>
        </div>
      )}

      <section class="mt-10">
        <h2 class="mb-4 font-head text-2xl font-extrabold">บทความของเกมนี้</h2>
        {articles.length ? <div class="grid gap-5 sm:grid-cols-2">{articles.slice(0,4).map((a) => <ArticleCard article={a} />)}</div> : <p class="text-[var(--fg-muted)]">ยังไม่มีบทความ</p>}
      </section>

      <section class="mt-10">
        <h2 class="mb-4 font-head text-2xl font-extrabold">เด็คของเกมนี้</h2>
        {decks.length ? <div class="grid gap-4">{decks.map((x) => <DeckCard deck={x} />)}</div> : <p class="text-[var(--fg-muted)]">ยังไม่มีเด็ค</p>}
      </section>
    </div>

    <aside>
      <div class="sticky top-20 space-y-6">
        {headings.length > 0 && (
          <nav class="rounded-2xl border border-[var(--border)] bg-[var(--bg-elev)] p-5">
            <h2 class="font-head text-sm font-bold uppercase tracking-wide text-[var(--gold)]">สารบัญ</h2>
            <ul class="mt-3 space-y-1.5 text-sm">{headings.map((h) => (<li><a class="text-[var(--fg-muted)] hover:text-[var(--accent)]" href={`#${h.slug}`}>{h.text}</a></li>))}</ul>
          </nav>
        )}
        {terms.length > 0 && (
          <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-elev)] p-5">
            <h2 class="font-head text-sm font-bold uppercase tracking-wide text-[var(--gold)]">ศัพท์เฉพาะ</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {terms.slice(0,8).map((t) => (<li><a href={url(`/glossary#${t.id}`)} class="hover:text-[var(--accent)]"><b>{t.data.term}</b> <span class="text-[var(--fg-muted)]">({t.data.termEn})</span></a></li>))}
            </ul>
            <a href={url('/glossary')} class="mt-3 inline-block text-sm text-[var(--gold)] hover:underline">ศัพท์ทั้งหมด →</a>
          </div>
        )}
      </div>
    </aside>
  </div>
</BaseLayout>
