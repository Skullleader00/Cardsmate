---
import { getCollection } from 'astro:content';
import Listing from '../components/ArticleListing.astro';
import { sortByDate } from '../lib/utils';
const articles = sortByDate(await getCollection('articles', ({ data }) => !data.draft && data.type === 'review'));
const games = await getCollection('games');
---
<Listing title="รีวิวเซ็ตและอุปกรณ์" eyebrow="Review" description="รีวิวเซ็ต สตาร์เตอร์เด็ค และอุปกรณ์เสริม พร้อมคะแนนเต็ม 10 (เนื้อหาตัวอย่าง)" articles={articles} games={games} />
