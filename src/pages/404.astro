---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../site';
---
<BaseLayout title="ไม่พบหน้า (404)" noindex>
  <div class="mx-auto grid min-h-[55vh] max-w-2xl place-items-center px-4 py-16 text-center">
    <div class="w-full">
      <p class="font-head text-7xl font-black foil">404</p>
      <h1 class="mt-2 font-head text-2xl font-bold">ไม่พบหน้าที่คุณมองหา</h1>
      <p class="mt-2 text-[var(--fg-muted)]">ลิงก์อาจผิดหรือถูกย้ายไปแล้ว ลองค้นหาหรือกลับไปหน้าแรก</p>

      <!-- ช่องค้นหา -->
      <form action={url('/search')} method="get" class="mx-auto mt-6 flex max-w-md items-center gap-2">
        <input
          type="search" name="q" placeholder="ค้นหาบทความ เด็ค ศัพท์…"
          aria-label="ค้นหา" required
          class="w-full rounded-xl border border-[var(--border)] bg-[var(--bg-elev)] px-4 py-3 outline-none focus:border-[var(--accent)]" />
        <button type="submit" class="shrink-0 rounded-xl bg-gradient-to-r from-[var(--accent)] to-[var(--gold)] px-5 py-3 font-semibold text-[#0f1220]">ค้นหา</button>
      </form>

      <div class="mt-6 flex justify-center gap-3">
        <a href={url('/')} class="rounded-xl border border-[var(--border)] bg-[var(--bg-elev)] px-5 py-3 font-semibold hover:bg-[var(--bg-elev-2)]">กลับหน้าแรก</a>
        <a href={url('/sitemap.xml')} class="rounded-xl border border-[var(--border)] bg-[var(--bg-elev)] px-5 py-3 font-semibold hover:bg-[var(--bg-elev-2)]">Sitemap</a>
      </div>
    </div>
  </div>
</BaseLayout>
