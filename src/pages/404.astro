---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../site';
---
<BaseLayout title="ไม่พบหน้า (404)" noindex>
  <div class="mx-auto grid min-h-[50vh] max-w-[var(--maxw)] place-items-center px-4 text-center">
    <div>
      <p class="font-head text-7xl font-black foil">404</p>
      <h1 class="mt-2 font-head text-2xl font-bold">ไม่พบหน้าที่คุณมองหา</h1>
      <p class="mt-2 text-[var(--fg-muted)]">ลิงก์อาจผิดหรือถูกย้ายไปแล้ว ลองกลับไปหน้าแรกหรือค้นหาแทน</p>
      <div class="mt-6 flex justify-center gap-3">
        <a href={url('/')} class="rounded-xl bg-gradient-to-r from-[var(--accent)] to-[var(--gold)] px-5 py-3 font-semibold text-[#0f1220]">หน้าแรก</a>
        <a href={url('/search')} class="rounded-xl border border-[var(--border)] bg-[var(--bg-elev)] px-5 py-3 font-semibold">ค้นหา</a>
      </div>
    </div>
  </div>
</BaseLayout>
