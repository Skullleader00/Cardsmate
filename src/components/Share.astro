---
// ปุ่มแชร์ (Facebook / X / LINE / คัดลอกลิงก์) — อ่าน URL ปัจจุบันฝั่ง client
---
<div class="flex flex-wrap items-center gap-2" id="share" data-share>
  <span class="text-sm font-semibold text-[var(--fg-muted)]">แชร์:</span>
  <a data-share="fb" target="_blank" rel="noopener" class="share-btn" aria-label="แชร์ลง Facebook">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.25-1.5 1.55-1.5H17V4.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.1H7.6V14h2.7v8z"/></svg>
  </a>
  <a data-share="x" target="_blank" rel="noopener" class="share-btn" aria-label="แชร์ลง X">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 3h3l-6.6 7.5L22 21h-6l-4.3-5.6L6.6 21H3.5l7-8L2 3h6.2l3.9 5.1zM16.4 19.2h1.7L7.7 4.7H5.9z"/></svg>
  </a>
  <a data-share="line" target="_blank" rel="noopener" class="share-btn" aria-label="แชร์ลง LINE">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C6.9 3 2.75 6.4 2.75 10.5c0 3.7 3.3 6.8 7.75 7.4.3.06.7.2.8.45.08.22.05.55.02.77l-.13.78c-.04.22-.17.86.75.47.92-.4 4.97-2.93 6.78-5.02C20.4 14.6 21.25 12.66 21.25 10.5 21.25 6.4 17.1 3 12 3zM8.1 12.9H6.2c-.28 0-.5-.22-.5-.5V8.4c0-.28.22-.5.5-.5s.5.22.5.5v3.5h.9c.28 0 .5.22.5.5s-.22.5-.5.5zm1.7-.5c0 .28-.22.5-.5.5s-.5-.22-.5-.5V8.4c0-.28.22-.5.5-.5s.5.22.5.5zm3.2 0c0 .2-.12.38-.3.46-.07.03-.14.04-.2.04-.14 0-.27-.06-.35-.18l-1.5-2.05v1.73c0 .28-.22.5-.5.5s-.5-.22-.5-.5V8.4c0-.2.12-.38.3-.46.25-.12.54-.04.7.18l1.5 2.05V8.4c0-.28.22-.5.5-.5s.5.22.5.5zm2.6-1.9c.28 0 .5.22.5.5s-.22.5-.5.5h-.9v.9h.9c.28 0 .5.22.5.5s-.22.5-.5.5h-1.4c-.28 0-.5-.22-.5-.5V8.4c0-.28.22-.5.5-.5z"/></svg>
  </a>
  <button data-share="copy" class="share-btn" aria-label="คัดลอกลิงก์">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
  </button>
  <span id="share-msg" class="text-xs text-[var(--tag-guide)] opacity-0 transition">คัดลอกแล้ว!</span>
</div>
<style>
  .share-btn { display:inline-grid; place-items:center; width:36px; height:36px; border-radius:10px;
    border:1px solid var(--border); background:var(--bg-elev); color:var(--fg-muted); transition:.15s; }
  .share-btn:hover { color:var(--fg); border-color:var(--accent); }
  .share-btn svg { width:18px; height:18px; }
</style>
<script>
  const wrap = document.getElementById('share');
  if (wrap) {
    const url = encodeURIComponent(location.href);
    const text = encodeURIComponent(document.title);
    (wrap.querySelector('[data-share=fb]') as HTMLAnchorElement).href = `https://www.facebook.com/sharer/sharer.php?u=${url}`;
    (wrap.querySelector('[data-share=x]') as HTMLAnchorElement).href = `https://twitter.com/intent/tweet?url=${url}&text=${text}`;
    (wrap.querySelector('[data-share=line]') as HTMLAnchorElement).href = `https://social-plugins.line.me/lineit/share?url=${url}`;
    wrap.querySelector('[data-share=copy]')?.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(location.href); } catch {}
      const m = document.getElementById('share-msg');
      m?.style.setProperty('opacity', '1');
      setTimeout(() => m?.style.setProperty('opacity', '0'), 1500);
    });
  }
</script>
