---
import { NAV, SITE, url } from '../site';
---
<footer class="mt-16 border-t border-[var(--border)] bg-[var(--bg-elev)]">
  <div class="mx-auto grid max-w-[var(--maxw)] gap-8 px-4 py-12 md:grid-cols-4">
    <div class="md:col-span-2">
      <a href={url('/')} class="flex items-center gap-2 font-head text-lg font-extrabold">
        <span class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-[var(--accent)] to-[var(--gold)] text-[#0f1220] font-black">C</span>
        <span class="foil">Cardsmate</span>
      </a>
      <p class="mt-3 max-w-md text-sm text-[var(--fg-muted)]">{SITE.description}</p>
      <p class="mt-3 text-xs text-[var(--fg-muted)]">เนื้อหาส่วนใหญ่เป็น “ข้อมูลตัวอย่าง” เพื่อสาธิตโครงสร้างเว็บ</p>
    </div>
    <div>
      <h3 class="font-head text-sm font-bold uppercase tracking-wide text-[var(--fg)]">สำรวจ</h3>
      <ul class="mt-3 space-y-2 text-sm text-[var(--fg-muted)]">
        {NAV.map((n) => (<li><a class="hover:text-[var(--accent)]" href={url(n.href)}>{n.label}</a></li>))}
        <li><a class="hover:text-[var(--accent)]" href={url('/glossary')}>พจนานุกรมศัพท์</a></li>
      </ul>
    </div>
    <div>
      <h3 class="font-head text-sm font-bold uppercase tracking-wide text-[var(--fg)]">เกี่ยวกับ</h3>
      <ul class="mt-3 space-y-2 text-sm text-[var(--fg-muted)]">
        <li><a class="hover:text-[var(--accent)]" href={url('/about')}>เกี่ยวกับเรา</a></li>
        <li><a class="hover:text-[var(--accent)]" href={url('/contact')}>ติดต่อ</a></li>
        <li><a class="hover:text-[var(--accent)]" href={url('/terms')}>ความเป็นส่วนตัว</a></li>
        <li><a class="hover:text-[var(--accent)]" href={url('/rss.xml')}>RSS</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-[var(--border)] py-5 text-center text-xs text-[var(--fg-muted)]">
    © {new Date().getFullYear()} {SITE.name} · สร้างด้วย Astro · เกม/การ์ดทั้งหมดเป็นเครื่องหมายการค้าของเจ้าของแต่ละราย
  </div>
</footer>
