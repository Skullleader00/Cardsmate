---
import { url } from '../site';
import { PLATFORM_LABEL } from '../lib/utils';
const { game } = Astro.props;
const d = game.data;
const href = url(`/game/${game.id}`);
---
<a href={href} class="group relative block overflow-hidden rounded-2xl border border-[var(--border)] p-5 transition hover:-translate-y-0.5"
  style={`background:linear-gradient(150deg, color-mix(in srgb, ${d.accent} 30%, var(--bg-elev)), var(--bg-elev))`}>
  <div class="flex items-center gap-2">
    <span class="grid h-10 w-10 place-items-center rounded-xl font-head text-lg font-black text-[#0f1220]" style={`background:${d.accent}`}>{d.shortName.slice(0,1)}</span>
    <div>
      <h3 class="font-head text-lg font-bold group-hover:text-[var(--accent)]">{d.name}</h3>
      <p class="text-xs text-[var(--fg-muted)]">{d.publisher}</p>
    </div>
  </div>
  <p class="mt-3 line-clamp-2 text-sm text-[var(--fg-muted)]">{d.description}</p>
  <div class="mt-3 flex flex-wrap gap-1.5">
    {d.platforms.map((p: string) => (
      <span class="rounded-full border border-[var(--border)] bg-[var(--bg-elev)]/60 px-2 py-0.5 text-[11px] text-[var(--fg-muted)]">{PLATFORM_LABEL[p]}</span>
    ))}
  </div>
</a>
