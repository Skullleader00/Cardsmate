---
import { url } from '../site';
const { children, href, eyebrow } = Astro.props;
---
<section class="mx-auto max-w-[var(--maxw)] px-4 py-8">
  <div class="mb-5 flex items-end justify-between gap-4">
    <div>
      {eyebrow && <p class="text-xs font-semibold uppercase tracking-widest text-[var(--accent)]">{eyebrow}</p>}
      <h2 class="font-head text-2xl font-extrabold sm:text-3xl"><slot /></h2>
    </div>
    {href && <a href={url(href)} class="shrink-0 text-sm font-semibold text-[var(--gold)] hover:underline">ดูทั้งหมด →</a>}
  </div>
  <slot name="body" />
</section>
