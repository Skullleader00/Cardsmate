---
import { url, TYPE_COLOR } from '../site';
import { formatDate, readingTime } from '../lib/utils';
import TypeBadge from './TypeBadge.astro';
import ReviewBadge from './ReviewBadge.astro';

const { article, showType = true } = Astro.props;
const d = article.data;
const href = url(`/article/${article.id}`);
const color = TYPE_COLOR[d.type] || 'var(--accent)';
const mins = readingTime(article.body || '');
---
<article class="group flex flex-col overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--bg-elev)] transition hover:-translate-y-0.5 hover:border-[var(--accent)]">
  <a href={href} class="relative block aspect-[16/9] overflow-hidden" tabindex="-1" aria-hidden="true">
    {d.hero ? (
      <img src={url(d.hero)} alt="" class="h-full w-full object-cover" loading="lazy" />
    ) : (
      <div class="grid h-full w-full place-items-center" style={`background:linear-gradient(135deg, color-mix(in srgb, ${color} 55%, #0f1220), #0f1220)`}>
        <span class="font-head text-5xl font-black text-white/80">{d.title.slice(0, 1)}</span>
      </div>
    )}
    {d.type === 'review' && d.reviewScore != null && <ReviewBadge score={d.reviewScore} />}
  </a>
  <div class="flex flex-1 flex-col p-4">
    <div class="mb-2 flex items-center gap-2">
      {showType && <TypeBadge type={d.type} />}
      {d.game && <span class="text-xs text-[var(--fg-muted)]">#{d.game}</span>}
    </div>
    <h3 class="font-head text-lg font-bold leading-snug">
      <a href={href} class="hover:text-[var(--accent)]">{d.title}</a>
    </h3>
    <p class="mt-2 line-clamp-3 text-sm text-[var(--fg-muted)]">{d.description}</p>
    <div class="mt-3 flex items-center gap-3 text-xs text-[var(--fg-muted)]">
      <time datetime={new Date(d.date).toISOString()}>{formatDate(d.date)}</time>
      <span>·</span><span>{mins} นาที</span>
    </div>
  </div>
</article>
