---
import { NAV, SITE } from '../site';
import { url } from '../site';
import ThemeToggle from './ThemeToggle.astro';
---
<header class="sticky top-0 z-50 border-b border-[var(--border)] bg-[color-mix(in_srgb,var(--bg)_85%,transparent)] backdrop-blur">
  <div class="mx-auto flex h-16 max-w-[var(--maxw)] items-center gap-3 px-4">
    <a href={url('/')} class="flex items-center gap-2 font-head text-xl font-extrabold" aria-label={`${SITE.name} หน้าแรก`}>
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-[var(--accent)] to-[var(--gold)] text-[#0f1220] font-black">C</span>
      <span class="foil">Cardsmate</span>
    </a>

    <nav class="ml-4 hidden items-center gap-1 lg:flex" aria-label="เมนูหลัก">
      {NAV.map((n) => (
        <a href={url(n.href)} class="rounded-lg px-3 py-2 text-sm font-medium text-[var(--fg-muted)] transition hover:bg-[var(--bg-elev)] hover:text-[var(--fg)]">{n.label}</a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a href={url('/search')} id="search-btn"
         class="hidden items-center gap-2 rounded-lg border border-[var(--border)] bg-[var(--bg-elev)] px-3 py-2 text-sm text-[var(--fg-muted)] hover:bg-[var(--bg-elev-2)] sm:flex">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <span>ค้นหา</span>
        <kbd class="rounded border border-[var(--border)] px-1.5 text-xs">/</kbd>
      </a>
      <a href={url('/search')} class="grid h-9 w-9 place-items-center rounded-lg border border-[var(--border)] bg-[var(--bg-elev)] sm:hidden" aria-label="ค้นหา">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      </a>
      <ThemeToggle />
      <button id="menu-btn" class="grid h-9 w-9 place-items-center rounded-lg border border-[var(--border)] bg-[var(--bg-elev)] lg:hidden" aria-label="เปิดเมนู" aria-expanded="false">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-[var(--border)] bg-[var(--bg-elev)] lg:hidden">
    <nav class="mx-auto grid max-w-[var(--maxw)] gap-1 px-4 py-3" aria-label="เมนูมือถือ">
      {NAV.map((n) => (
        <a href={url(n.href)} class="rounded-lg px-3 py-2.5 font-medium text-[var(--fg)] hover:bg-[var(--bg-elev-2)]">{n.label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    menuBtn.setAttribute('aria-expanded', String(open));
  });
  // คีย์ลัด "/" ไปหน้าค้นหา
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && !/input|textarea|select/i.test((e.target as HTMLElement)?.tagName || '')) {
      e.preventDefault();
      window.location.href = (window.CARDSMATE_BASE || '') + '/search';
    }
  });
</script>
