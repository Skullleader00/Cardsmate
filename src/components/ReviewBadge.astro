---
// ป้ายคะแนนรีวิวมุมรูป (เต็ม 10)
const { score } = Astro.props;
const s = Number(score);
const tone = s >= 8 ? 'var(--tag-guide)' : s >= 6 ? 'var(--gold)' : 'var(--tag-review)';
---
{!Number.isNaN(s) && (
  <div class="absolute right-3 top-3 z-10 grid h-12 w-12 place-items-center rounded-full font-head font-extrabold text-[#0f1220] shadow-lg"
    style={`background:${tone}`} aria-label={`คะแนนรีวิว ${s} เต็ม 10`}>
    <span class="text-base leading-none">{s.toFixed(1)}</span>
    <span class="text-[8px] leading-none">/10</span>
  </div>
)}
