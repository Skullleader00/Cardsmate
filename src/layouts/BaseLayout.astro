---
import { SITE, url } from '../site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
  noindex?: boolean;
  bodyClass?: string;
};

const {
  title,
  description = SITE.description,
  ogImage = url(SITE.ogImage),
  jsonLd,
  noindex = false,
  bodyClass = '',
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ldList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const baseLiteral = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0f1220" />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- PWA / icons -->
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" href={url('/icons/icon-192.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="th_TH" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Fonts: Noto Sans Thai (body) + Prompt (head) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Prompt:wght@500;600;700;800&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" />

    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/rss.xml')} />

    <!-- ป้องกัน FOUC + base path ให้ script ฝั่ง client -->
    <script is:inline set:html={`(function(){try{if(localStorage.getItem('theme')==='light')document.documentElement.classList.add('theme-light');}catch(e){}window.CARDSMATE_BASE=${JSON.stringify(baseLiteral)};})();`} />
    {ldList.map((obj) => (<script type="application/ld+json" set:html={JSON.stringify(obj)} />))}
    <slot name="head" />
  </head>
  <body class={`min-h-screen ${bodyClass}`}>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-[60] focus:rounded focus:bg-[var(--gold)] focus:px-3 focus:py-2 focus:text-[#0f1220]">ข้ามไปที่เนื้อหา</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <!-- Card hover preview runtime -->
    <script>
      import { initCardEmbed } from '../lib/card-embed';
      initCardEmbed();
    </script>
  </body>
</html>
